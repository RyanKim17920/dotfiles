#!/usr/bin/env bash
# ssh-setup <host>
# ssh-setup --all      (re-sync every host set up before; see run_all)
#
# Install yazi (+ ya), micro, glow and resvg plus this Mac's yazi/micro configs and
# Claude Code status line into YOUR OWN home directory on a remote Linux host. No sudo, nothing system-wide.
# User-invoked per host; re-running is a fast no-op when nothing changed.
#
# Remote changes (all under $HOME):
#   ~/.local/bin/{yazi,ya,micro,glow,glow-cached,mdview,mdedit,mdpreview}
#                              (glow-cached: yazi md previewer; mdview: yazi R
#                              full-screen reader; mdedit + mdpreview: Enter on
#                              .md opens micro with a live preview split, opened
#                              by ~/.wezterm.lua on this Mac via user vars)
#   ~/.local/bin/resvg         (yazi's SVG previewer; x86_64 only, as upstream
#                              publishes no Linux aarch64 binary)
#   ~/.config/yazi/            (local config, as is)
#   ~/.config/micro/settings.json
#   ~/.claude/statusline.sh    (only this from ~/.claude; nothing else is copied)
#   ~/.claude/settings.json    (only the "statusLine" key is set; others untouched)
#   ~/.local/bin/jq            (only if the remote has no usable system jq)
#   ~/.local/share/ssh-setup/stamp      (version/config hash for idempotency)
#   ~/.bashrc                  (one block between the ssh-setup markers)
# Pre-existing ~/.config/{yazi,micro}, binaries, ~/.claude/statusline.sh and
# ~/.claude/settings.json are backed up once to *.bak-ssh-setup before the
# first install that touches them.
# Local state: hosts set up successfully are listed one per line in
# ~/.local/state/ssh-setup/hosts (what --all re-syncs).
set -euo pipefail

FORMAT=1   # bump when the remote layout or bashrc block changes
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/ssh-setup"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=15)
# --all: ride the live ControlMaster only. If the master is gone, the direct
# connection fallback runs ProxyCommand=false and fails at once, so no login
# (and no 2FA push) is ever attempted from automation.
if [ -n "${SSH_SETUP_MUX_ONLY:-}" ]; then
	SSH_OPTS+=(-o ControlMaster=no -o ProxyCommand=false)
fi
HOSTS_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/ssh-setup/hosts"
MARK_BEGIN='# >>> ssh-setup >>>'
MARK_END='# <<< ssh-setup <<<'
# Space-separated hosts to refuse (e.g. a forced-command bastion that cannot
# run arbitrary commands). Matched by alias and by resolved hostname.
BLOCKED_HOSTS="${SSH_SETUP_SKIP_HOSTS:-}"

die()  { printf 'ssh-setup: %s\n' "$*" >&2; exit 1; }
info() { printf '  %s\n' "$*"; }
warn() { printf 'ssh-setup: warning: %s\n' "$*" >&2; }

usage() {
	cat <<EOF
usage: ssh-setup <host>   set up or update one host
       ssh-setup --all    update every host set up before, in parallel; hosts
                          without a live ssh connection (ControlMaster) are
                          skipped, never logged in to
Installs yazi, ya, micro, glow, your yazi/micro configs and your Claude Code
status line (~/.claude/statusline.sh + the settings.json statusLine key) into ~ on <host>.
EOF
}

# --- 1. refuse skipped hosts (by alias and by resolved hostname) ----------
resolved() { ssh -G "$1" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }'; }
# prints why <host> is refused, if it is
blocked_reason() {
	local b bh
	for b in $BLOCKED_HOSTS; do
		[ "$1" = "$b" ] && { echo "listed in SSH_SETUP_SKIP_HOSTS"; return; }
		bh="$(resolved "$b")"
		if [ -n "$bh" ] && [ "$(resolved "$1")" = "$bh" ]; then
			echo "resolves to the same host as $b"; return
		fi
	done
}

# Remember a host that was set up successfully (for --all)
record_host() {
	mkdir -p "$(dirname "$HOSTS_FILE")"
	touch "$HOSTS_FILE"
	grep -qxF -- "$1" "$HOSTS_FILE" || printf '%s\n' "$1" >>"$HOSTS_FILE"
}

# --all: re-run this script for every recorded host whose ControlMaster is
# live (ssh -O check only asks the local master socket; it never connects),
# in parallel, then print one summary line per host.
run_all() {
	[ -s "$HOSTS_FILE" ] || die "no hosts recorded yet in $HOSTS_FILE; run 'ssh-setup <host>' once per host"
	local tmp h i=0 n reason rc log t pids=() hosts=() failed=0
	tmp="$(mktemp -d "${TMPDIR:-/tmp}/ssh-setup-all.XXXXXX")"
	while IFS= read -r h || [ -n "$h" ]; do
		h="${h%%#*}"; h="${h//[[:space:]]/}"
		[ -n "$h" ] && hosts+=("$h")
	done <"$HOSTS_FILE"
	[ ${#hosts[@]} -gt 0 ] || die "no hosts recorded in $HOSTS_FILE"
	echo "ssh-setup --all: ${hosts[*]}"
	for h in "${hosts[@]}"; do
		reason="$(blocked_reason "$h")"
		if [ -n "$reason" ]; then
			echo "skipped $h: $reason" >"$tmp/$i.sum"; pids+=("")
		elif ! ssh -O check "$h" >/dev/null 2>&1; then
			echo "skipped $h: not connected (open an ssh pane to it first)" >"$tmp/$i.sum"; pids+=("")
		else
			SSH_SETUP_MUX_ONLY=1 "$BASH" "$0" "$h" >"$tmp/$i.log" 2>&1 &
			pids+=("$!")
		fi
		i=$((i + 1))
	done
	n=$i
	for ((i = 0; i < n; i++)); do
		h="${hosts[$i]}"
		if [ -z "${pids[$i]}" ]; then cat "$tmp/$i.sum"; continue; fi
		rc=0; wait "${pids[$i]}" || rc=$?
		log="$tmp/$i.log"
		t="$(grep -o '\[[0-9]*s\]' "$log" | tail -1 || true)"
		if [ $rc -ne 0 ]; then
			failed=1
			echo "FAILED  $h (exit $rc): $({ grep '^ssh-setup:' "$log" || tail -1 "$log"; } | tail -1 | sed 's/^ssh-setup: //')"
			echo "        log: $log"
		elif grep -q 'already up to date' "$log"; then
			echo "ok      $h: already up to date $t"
		else
			echo "ok      $h: updated $t$(grep -q 'bashrc: block updated' "$log" && echo ' (bashrc block updated)')"
		fi
	done
	[ $failed -eq 0 ] && rm -rf "$tmp"
	return $failed
}

case "${1:-}" in
	-h|--help) usage; exit 0 ;;
	--all) [ $# -eq 1 ] || { usage >&2; exit 2; }; run_all; exit ;;
	''|-*) usage >&2; exit 2 ;;
esac
[ $# -eq 1 ] || { usage >&2; exit 2; }
HOST="$1"
reason="$(blocked_reason "$HOST")"
[ -z "$reason" ] || die "refusing to target $HOST ($reason)"

for c in curl jq shasum unzip bsdtar ssh awk; do
	command -v "$c" >/dev/null || die "missing local dependency: $c"
done

START=$SECONDS
# Run a POSIX sh script remotely regardless of the remote login shell.
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
rsh() { ssh "${SSH_OPTS[@]}" "$HOST" "sh -c $(sq "$1")"; }
ERRF="$(mktemp "${TMPDIR:-/tmp}/ssh-setup-err.XXXXXX")"

# --- 2. probe the remote (one round trip) ----------------------------------
probe="$(rsh 'uname -sm
printf "stamp=%s\n" "$(cat "$HOME/.local/share/ssh-setup/stamp" 2>/dev/null || echo none)"
for b in yazi ya micro glow glow-cached mdview mdedit mdpreview resvg jq; do [ -x "$HOME/.local/bin/$b" ] || echo "missing=$b"; done
[ -x "$HOME/.claude/statusline.sh" ] || echo missing=statusline.sh
grep -qF "\"statusLine\"" "$HOME/.claude/settings.json" 2>/dev/null || echo missing=statusLine
# a usable jq outside ~/.local/bin (join/map need jq >= 1.5)
IFS=:; for d in $PATH; do
	[ "$d" = "$HOME/.local/bin" ] && continue
	if [ -x "$d/jq" ] && [ "$("$d/jq" -nr "[1,2] | map(tostring) | join(\",\")" 2>/dev/null)" = "1,2" ]; then echo "jq_sys=$d/jq"; break; fi
done; unset IFS
command -v pdftoppm >/dev/null 2>&1 && echo pdftoppm=yes || echo pdftoppm=no' 2>"$ERRF")" || {
	rc=$?
	cat "$ERRF" >&2
	if [ $rc -eq 255 ]; then
		if ! ssh -O check "$HOST" >/dev/null 2>&1; then
			die "cannot connect to $HOST non-interactively and there is no live master connection.
  If $HOST needs a password or Duo, run 'ssh $HOST' in another terminal first, then re-run."
		fi
		die "ssh to $HOST failed (exit 255) even though a master connection exists"
	fi
	die "remote probe on $HOST failed (exit $rc)"
}

read -r os rarch <<<"$(printf '%s\n' "$probe" | head -1)"
[ "$os" = "Linux" ] || die "$HOST runs '$os $rarch'; only Linux x86_64/aarch64 are supported"
case "$rarch" in
	x86_64)        ARCH=x86_64;  YAZI_T=x86_64;  MICRO_T=linux64-static; GLOW_T=Linux_x86_64 ;;
	aarch64|arm64) ARCH=aarch64; YAZI_T=aarch64; MICRO_T=linux-arm64;    GLOW_T=Linux_arm64 ;;
	*) die "$HOST is Linux $rarch; only x86_64 and aarch64 are supported" ;;
esac
remote_stamp="$(printf '%s\n' "$probe" | sed -n 's/^stamp=//p')"
remote_missing="$(printf '%s\n' "$probe" | sed -n 's/^missing=//p' | tr '\n' ' ')"
pdftoppm="$(printf '%s\n' "$probe" | sed -n 's/^pdftoppm=//p')"
jq_sys="$(printf '%s\n' "$probe" | sed -n 's/^jq_sys=//p')"
# ship a static jq only when the remote has no usable one (statusline.sh needs it)
if [ -n "$jq_sys" ]; then SHIP_JQ=no; else SHIP_JQ=yes; fi
# ~/.local/bin/jq only counts as missing when we are the ones shipping it
remote_missing="$(printf '%s\n' $remote_missing | { [ "$SHIP_JQ" = yes ] && cat || { grep -vx jq || true; }; } | tr '\n' ' ' | sed 's/ *$//')"
case "$ARCH" in x86_64) JQ_T=jq-linux-amd64 ;; aarch64) JQ_T=jq-linux-arm64 ;; esac
# resvg (SVG previews): upstream only publishes a Linux x86_64 binary
case "$ARCH" in x86_64) RESVG_T=resvg-linux-x86_64.tar.gz; SHIP_RESVG=yes ;; *) RESVG_T=; SHIP_RESVG=no ;; esac
if [ "$SHIP_RESVG" = no ]; then
	remote_missing="$(printf '%s\n' $remote_missing | { grep -vx resvg || true; } | tr '\n' ' ' | sed 's/ *$//')"
fi

# --- local versions (what we try to match) ----------------------------------
yazi_v="$(yazi --version 2>/dev/null | awk '/Version:/ { print $2; exit }' || true)"
micro_v="$(micro --version 2>/dev/null | awk '/Version:/ { print $2; exit }' || true)"
glow_v="$(glow --version 2>/dev/null | awk '{ print $3; exit }' || true)"
resvg_v="$(resvg --version 2>/dev/null | awk 'NR == 1 { print $NF }' || true)"

# --- stage configs (cheap; needed for the idempotency hash) ----------------
STAGE="$(mktemp -d "${TMPDIR:-/tmp}/ssh-setup.XXXXXX")"
trap 'rm -rf "$STAGE" "$ERRF"' EXIT

stage_configs() {
	local src="$HOME/.config/yazi" dst="$STAGE/.config/yazi"
	[ -d "$src" ] || die "no local ~/.config/yazi"
	mkdir -p "$dst" "$STAGE/.config/micro" "$STAGE/.local/bin" "$STAGE/.local/share/ssh-setup"
	local f
	for f in yazi.toml keymap.toml theme.toml package.toml init.lua; do
		[ -f "$src/$f" ] && cp "$src/$f" "$dst/$f"
	done
	for f in plugins flavors; do
		# -L: custom plugins may be symlinks into a dotfiles checkout
		[ -d "$src/$f" ] && cp -RL "$src/$f" "$dst/$f"
	done
	[ -f "$HOME/.config/micro/settings.json" ] && cp "$HOME/.config/micro/settings.json" "$STAGE/.config/micro/"
	# Claude Code status line: the script only (never anything else from ~/.claude)
	[ -f "$HOME/.claude/statusline.sh" ] || die "no local ~/.claude/statusline.sh"
	mkdir -p "$STAGE/.claude"
	cp "$HOME/.claude/statusline.sh" "$STAGE/.claude/statusline.sh"
	chmod 755 "$STAGE/.claude/statusline.sh"
	# glow wrapper that yazi.toml's *.md previewer runs (caches rendered output)
	[ -f "$HOME/.local/bin/glow-cached" ] || die "no local ~/.local/bin/glow-cached"
	cp "$HOME/.local/bin/glow-cached" "$STAGE/.local/bin/glow-cached"
	chmod 755 "$STAGE/.local/bin/glow-cached"
	# mdview: full-screen Markdown reader that keymap.toml's R binding runs;
	# mdedit: yazi.toml's Enter-on-.md opener; mdpreview: its preview pane
	for f in mdview mdedit mdpreview; do
		[ -f "$HOME/.local/bin/$f" ] || die "no local ~/.local/bin/$f"
		cp "$HOME/.local/bin/$f" "$STAGE/.local/bin/$f"
		chmod 755 "$STAGE/.local/bin/$f"
	done
	find "$STAGE" -name .DS_Store -delete
	chmod -R u+w "$STAGE"
}
stage_configs

# statusLine value for the remote settings.json: mirror the local one, if set
STATUSLINE_JSON='{"type":"command","command":"~/.claude/statusline.sh","padding":0}'
if local_sl="$(jq -ce '.statusLine | select(type == "object")' "$HOME/.claude/settings.json" 2>/dev/null)"; then
	STATUSLINE_JSON="$local_sl"
fi
printf '%s\n' "$STATUSLINE_JSON" >"$STAGE/.local/share/ssh-setup/statusline.json"

BASHRC_BLOCK="$MARK_BEGIN (added by ssh-setup; delete this block to undo)
case \":\$PATH:\" in *\":\$HOME/.local/bin:\"*) ;; *) export PATH=\"\$HOME/.local/bin:\$PATH\" ;; esac
export EDITOR=micro
y() {
	local tmp cwd
	tmp=\"\$(mktemp -t yazi-cwd.XXXXXX)\"
	command yazi \"\$@\" --cwd-file=\"\$tmp\"
	IFS= read -r -d '' cwd < \"\$tmp\"
	[ -n \"\$cwd\" ] && [ \"\$cwd\" != \"\$PWD\" ] && builtin cd -- \"\$cwd\"
	rm -f -- \"\$tmp\"
}
$MARK_END"

STAMP="$(
	{
		printf 'format=%s arch=%s yazi=%s micro=%s glow=%s ship_jq=%s resvg=%s\n' "$FORMAT" "$ARCH" "$yazi_v" "$micro_v" "$glow_v" "$SHIP_JQ" "$([ "$SHIP_RESVG" = yes ] && echo "${resvg_v:-latest}" || echo none)"
		printf '%s\n' "$BASHRC_BLOCK" "$STATUSLINE_JSON"
		(cd "$STAGE" && find .config .claude .local/bin/glow-cached .local/bin/mdview .local/bin/mdedit .local/bin/mdpreview -type f | LC_ALL=C sort | while IFS= read -r f; do shasum -a 256 "$f"; done)
	} | shasum -a 256 | awk '{ print $1 }'
)"

summary_tail() {
	echo "  pdftoppm on $HOST: $pdftoppm$([ "$pdftoppm" = no ] && echo ' (PDF previews unavailable; install poppler-utils to enable)')"
	[ "$SHIP_RESVG" = yes ] || echo "  resvg: not shipped (no Linux $ARCH release upstream; SVG previews unavailable)"
	cat <<EOF
  undo on $HOST:
    rm -f ~/.local/bin/{yazi,ya,micro,glow,glow-cached,mdview,mdedit,mdpreview,resvg} ~/.config/micro/settings.json
    rm -rf ~/.config/yazi ~/.local/share/ssh-setup
    sed -i '/^$MARK_BEGIN/,/^$MARK_END/d' ~/.bashrc
    rm -f ~/.claude/statusline.sh$([ "$SHIP_JQ" = yes ] && echo ' ~/.local/bin/jq')
    $([ "$SHIP_JQ" = yes ] && echo '~/.local/bin/jq' || echo jq) 'del(.statusLine)' ~/.claude/settings.json > ~/.claude/s.tmp && mv ~/.claude/s.tmp ~/.claude/settings.json
    # or restore ~/.claude/{settings.json,statusline.sh}.bak-ssh-setup if present
    # then restore any ~/.config/{yazi,micro}.bak-ssh-setup or ~/.local/bin/*.bak-ssh-setup
EOF
}

if [ "$remote_stamp" = "$STAMP" ] && [ -z "$remote_missing" ]; then
	record_host "$HOST"
	echo "ssh-setup: $HOST ($ARCH) already up to date (yazi $yazi_v, micro $micro_v, glow $glow_v$([ "$SHIP_RESVG" = yes ] && echo ", resvg $resvg_v")) [$((SECONDS - START))s]"
	summary_tail
	exit 0
fi

# --- 3. fetch release binaries (cached per arch/version) -------------------
api() {
	local auth=()
	[ -n "${GITHUB_TOKEN:-}" ] && auth=(-H "Authorization: Bearer $GITHUB_TOKEN")
	curl -fsSL "${auth[@]+"${auth[@]}"}" -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$1"
}

# fetch_release <repo> <version|""> <asset-name-template with {v}>  -> prints "path version"
fetch_release() {
	local repo="$1" want="$2" tmpl="$3" rel ver name url digest dir file
	rel=""
	if [ -n "$want" ]; then rel="$(api "$repo/releases/tags/v$want" 2>/dev/null || true)"; fi
	if [ -z "$rel" ]; then
		[ -n "$want" ] && warn "$repo has no release v$want; using latest"
		rel="$(api "$repo/releases/latest")" || die "cannot query GitHub releases for $repo"
	fi
	ver="$(jq -r '.tag_name' <<<"$rel" | sed 's/^v//')"
	name="${tmpl//\{v\}/$ver}"
	url="$(jq -r --arg n "$name" '.assets[] | select(.name == $n) | .browser_download_url' <<<"$rel")"
	digest="$(jq -r --arg n "$name" '.assets[] | select(.name == $n) | .digest // empty' <<<"$rel")"
	[ -n "$url" ] || die "$repo v$ver has no asset $name"
	dir="$CACHE/$ARCH/dl"; mkdir -p "$dir"; file="$dir/$name"
	if [ ! -s "$file" ]; then
		echo "  downloading $name" >&2
		curl -fsSL -o "$file.part" "$url" || die "download failed: $url"
		mv "$file.part" "$file"
	fi
	if [ -z "$digest" ]; then
		# fall back to a published checksum file (checksums.txt or <asset>.sha)
		local sums
		sums="$(jq -r --arg n "$name" '.assets[] | select(.name == "checksums.txt" or .name == "sha256sum.txt" or .name == ($n + ".sha")) | .browser_download_url' <<<"$rel" | head -1)"
		[ -n "$sums" ] && digest="sha256:$(curl -fsSL "$sums" | awk -v n="$name" '$2 == n || $2 == "*" n || NF == 1 { print $1; exit }')"
	fi
	if [ -n "$digest" ] && [ "$digest" != "sha256:" ]; then
		local got; got="sha256:$(shasum -a 256 "$file" | awk '{ print $1 }')"
		[ "$got" = "$digest" ] || { rm -f "$file"; die "checksum mismatch for $name ($got != $digest)"; }
	else
		warn "no published checksum for $name; not verified"
	fi
	printf '%s %s\n' "$file" "$ver"
}

# get_tool <tool> <repo> <want-version> <template> <binaries...>: cache dir with extracted binaries
get_tool() {
	local tool="$1" repo="$2" want="$3" tmpl="$4"; shift 4
	local bdir="$CACHE/$ARCH/$tool-${want:-latest}" b ok=1
	for b in "$@"; do [ -x "$bdir/$b" ] || ok=0; done
	if [ $ok -eq 0 ] || [ -z "$want" ]; then
		local out file ver x
		out="$(fetch_release "$repo" "$want" "$tmpl")" || exit 1
		file="${out% *}"; ver="${out##* }"
		bdir="$CACHE/$ARCH/$tool-$ver"
		x="$(mktemp -d "${TMPDIR:-/tmp}/ssh-setup-x.XXXXXX")"
		case "$file" in
			*.zip)    unzip -q "$file" -d "$x" ;;
			*.tar.gz) tar -xzf "$file" -C "$x" ;;
			*)        cp "$file" "$x/$1"; chmod 755 "$x/$1" ;;   # bare binary asset
		esac
		rm -rf "$bdir"; mkdir -p "$bdir"
		for b in "$@"; do
			local p; p="$(find "$x" -type f -name "$b" -perm -u+x | head -1)"
			[ -n "$p" ] || { rm -rf "$x"; die "$b not found in $(basename "$file")"; }
			cp "$p" "$bdir/$b"; chmod 755 "$bdir/$b"
		done
		rm -rf "$x"
	fi
	printf '%s\n' "$bdir"
}

echo "ssh-setup: $HOST is Linux $ARCH; preparing binaries"
d="$(get_tool yazi  sxyazi/yazi           "$yazi_v"  "yazi-$YAZI_T-unknown-linux-musl.zip" yazi ya)"; cp "$d/yazi" "$d/ya" "$STAGE/.local/bin/"
d="$(get_tool micro zyedidia/micro        "$micro_v" "micro-{v}-$MICRO_T.tar.gz" micro)";              cp "$d/micro" "$STAGE/.local/bin/"
d="$(get_tool glow  charmbracelet/glow    "$glow_v"  "glow_{v}_$GLOW_T.tar.gz" glow)";                cp "$d/glow" "$STAGE/.local/bin/"
if [ "$SHIP_RESVG" = yes ]; then
	d="$(get_tool resvg linebender/resvg  "$resvg_v" "$RESVG_T" resvg)";                              cp "$d/resvg" "$STAGE/.local/bin/"
fi
if [ "$SHIP_JQ" = yes ]; then
	d="$(get_tool jq jqlang/jq "" "$JQ_T" jq)";                                                        cp "$d/jq" "$STAGE/.local/bin/"
fi
printf '%s\n' "$STAMP" >"$STAGE/.local/share/ssh-setup/stamp"
printf '%s\n' "$BASHRC_BLOCK" >"$STAGE/.local/share/ssh-setup/bashrc-block"

# --- 4. one tar stream; remote backs up, extracts, appends bashrc block -----
REMOTE_SCRIPT='set -e
cd "$HOME"
if [ ! -f .local/share/ssh-setup/stamp ]; then
	for d in .config/yazi .config/micro; do
		if [ -e "$d" ] && [ ! -e "$d.bak-ssh-setup" ]; then cp -a "$d" "$d.bak-ssh-setup"; echo "backup: ~/$d.bak-ssh-setup"; fi
	done
	for b in yazi ya micro glow glow-cached mdview mdedit mdpreview resvg; do
		f=".local/bin/$b"
		if [ -e "$f" ] && [ ! -e "$f.bak-ssh-setup" ]; then cp -a "$f" "$f.bak-ssh-setup"; echo "backup: ~/$f.bak-ssh-setup"; fi
	done
fi
# first status-line install: back up what it is about to replace (once)
if [ ! -e .local/share/ssh-setup/statusline-installed ]; then
	for f in .claude/statusline.sh .claude/settings.json; do
		if [ -e "$f" ] && [ ! -e "$f.bak-ssh-setup" ]; then cp -p "$f" "$f.bak-ssh-setup"; echo "backup: ~/$f.bak-ssh-setup"; fi
	done
	f=.local/bin/jq
	if [ "$SHIP_JQ" = yes ] && [ -e "$f" ] && [ ! -e "$f.bak-ssh-setup" ]; then cp -a "$f" "$f.bak-ssh-setup"; echo "backup: ~/$f.bak-ssh-setup"; fi
fi
mkdir -p .local/bin .config
[ -d .claude ] || mkdir -m 700 .claude
tar -xf - -C "$HOME"
chmod 755 .claude/statusline.sh .local/bin/glow-cached .local/bin/mdview .local/bin/mdedit .local/bin/mdpreview
# merge only the statusLine key into ~/.claude/settings.json
S=.claude/settings.json SL="$(cat .local/share/ssh-setup/statusline.json)"
[ -L "$S" ] && S="$(readlink -f "$S")"   # edit a dotfiles-symlinked target in place
if [ -x .local/bin/jq ]; then JQ=.local/bin/jq; else JQ="$JQ_SYS"; fi
[ -e "$S" ] || { (umask 077; printf "{}\n" > "$S"); echo "settings: created ~/$S"; }
if [ -n "$JQ" ]; then
	if ! "$JQ" -e "type == \"object\"" "$S" >/dev/null 2>&1; then
		echo "WARNING: ~/$S is not a valid JSON object; left unchanged (statusLine NOT set)"
	elif "$JQ" -e --argjson sl "$SL" ".statusLine == \$sl" "$S" >/dev/null; then
		echo "settings: statusLine already set"
	else
		cp -p "$S" "$S.tmp-ssh-setup" && "$JQ" --argjson sl "$SL" ".statusLine = \$sl" "$S" > "$S.tmp-ssh-setup" \
			&& mv "$S.tmp-ssh-setup" "$S" && echo "settings: statusLine merged into ~/$S" \
			|| { rm -f "$S.tmp-ssh-setup"; echo "WARNING: failed to update ~/$S; left unchanged"; }
	fi
elif command -v python3 >/dev/null 2>&1; then
	python3 -I -c "
import json, os, shutil, sys
p, sl = sys.argv[1], json.loads(sys.argv[2])
try:
    d = json.load(open(p))
    assert isinstance(d, dict)
except Exception:
    print(\"WARNING: ~/\" + p + \" is not a valid JSON object; left unchanged (statusLine NOT set)\"); sys.exit(0)
if d.get(\"statusLine\") == sl:
    print(\"settings: statusLine already set\"); sys.exit(0)
d[\"statusLine\"] = sl
t = p + \".tmp-ssh-setup\"
shutil.copy2(p, t)
with open(t, \"w\") as f: json.dump(d, f, indent=2); f.write(\"\\n\")
os.replace(t, p)
print(\"settings: statusLine merged into ~/\" + p)
" "$S" "$SL"
else
	echo "WARNING: no jq or python3 on remote; ~/$S statusLine NOT set"
fi
touch .local/share/ssh-setup/statusline-installed
touch .bashrc
if ! grep -qF "'"$MARK_BEGIN"'" .bashrc; then
	{ [ -s .bashrc ] && [ -n "$(tail -c1 .bashrc)" ] && echo; echo; cat .local/share/ssh-setup/bashrc-block; } >> .bashrc
	echo "bashrc: block appended"
else
	echo "bashrc: block already present"
fi
echo "installed: yazi $(.local/bin/yazi --version 2>&1 | awk "/Version:/{print \$2; exit}"), micro $(.local/bin/micro --version 2>&1 | awk "/Version:/{print \$2; exit}"), glow $(.local/bin/glow --version 2>&1 | awk "{print \$3; exit}"), resvg $(.local/bin/resvg --version 2>/dev/null || echo none), statusline (jq: $(${JQ:-false} --version 2>/dev/null || echo none))"'

REMOTE_SCRIPT="JQ_SYS=$(sq "$jq_sys") SHIP_JQ=$SHIP_JQ
$REMOTE_SCRIPT"

echo "ssh-setup: pushing to $HOST"
COPYFILE_DISABLE=1 bsdtar -c -f - --format=ustar --uid 0 --gid 0 --uname root --gname root \
	-C "$STAGE" .local .config .claude/statusline.sh \
	| rsh "$REMOTE_SCRIPT" | sed 's/^/  /' || die "remote install on $HOST failed"

record_host "$HOST"
echo "ssh-setup: done [$((SECONDS - START))s]"
summary_tail
