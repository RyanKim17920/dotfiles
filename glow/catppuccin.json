{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#cdd6f4", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "▎ ", "color": "#a6adc8", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#cba6f7", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "block_prefix": "\n", "color": "#11111b", "background_color": "#cba6f7", "bold": true, "upper": true },
  "h2": { "prefix": "▍ ", "color": "#89b4fa", "bold": true },
  "h3": { "prefix": "▎ ", "color": "#a6e3a1", "bold": true },
  "h4": { "prefix": "", "color": "#fab387", "bold": true },
  "h5": { "prefix": "", "color": "#f9e2af", "bold": true },
  "h6": { "prefix": "", "color": "#7f849c", "bold": true },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true, "color": "#f5c2e7" },
  "strong": { "bold": true, "color": "#f9e2af" },
  "hr": { "color": "#45475a", "format": "\n────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#89b4fa", "underline": true },
  "link_text": { "color": "#74c7ec", "bold": true },
  "image": { "color": "#89b4fa", "underline": true },
  "image_text": { "color": "#a6adc8", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#fab387", "background_color": "#313244" },
  "code_block": {
    "color": "#cdd6f4",
    "margin": 2,
    "chroma": {
      "text": { "color": "#cdd6f4" },
      "error": { "color": "#11111b", "background_color": "#f38ba8" },
      "comment": { "color": "#6c7086" },
      "comment_preproc": { "color": "#f5c2e7" },
      "keyword": { "color": "#cba6f7" },
      "keyword_reserved": { "color": "#cba6f7" },
      "keyword_namespace": { "color": "#f5c2e7" },
      "keyword_type": { "color": "#f9e2af" },
      "operator": { "color": "#89dceb" },
      "punctuation": { "color": "#9399b2" },
      "name": { "color": "#cdd6f4" },
      "name_builtin": { "color": "#f38ba8" },
      "name_tag": { "color": "#cba6f7" },
      "name_attribute": { "color": "#89b4fa" },
      "name_class": { "color": "#f9e2af" },
      "name_constant": { "color": "#fab387" },
      "name_decorator": { "color": "#f5c2e7" },
      "name_function": { "color": "#89b4fa" },
      "literal_number": { "color": "#fab387" },
      "literal_string": { "color": "#a6e3a1" },
      "literal_string_escape": { "color": "#94e2d5" },
      "generic_deleted": { "color": "#f38ba8" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#a6e3a1" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#89b4fa" },
      "background": { "background_color": "#181825" }
    }
  },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─", "color": "#cdd6f4" },
  "definition_list": {},
  "definition_term": { "bold": true, "color": "#f9e2af" },
  "definition_description": { "block_prefix": "\n→ " },
  "html_block": {},
  "html_span": {}
}
